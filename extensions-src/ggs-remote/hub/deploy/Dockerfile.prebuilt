# CI repackage Dockerfile for the Hub image (docs/ggs-remote-plan.md §20.8–§20.9):
# wraps the statically linked musl binaries compiled natively on linux/amd64 and
# linux/arm64 runners into a multi-arch FROM scratch image — no QEMU emulation and no
# duplicate Rust release compile. Local builds keep using ../Dockerfile.
#
# Keep USER / ENTRYPOINT / EXPOSE in sync with ../Dockerfile.
FROM scratch
ARG TARGETARCH
COPY linux-${TARGETARCH}/ggs-remote-hub /ggs-remote-hub
USER 65534
ENTRYPOINT ["/ggs-remote-hub", "--config", "/etc/ggs-hub/hub.toml"]
EXPOSE 8443 8080
