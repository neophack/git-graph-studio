# The Linux build environment for Git Graph Studio, used by scripts/build-studio-linux.bat
# (local builds from Windows). CI builds the Linux installers natively on the ubuntu-24.04
# runner instead - higher glibc floor, no image to maintain (.github/workflows/studio.yml).
#
# A Tauri app cannot be cross-compiled from Windows the way the extension's .node engines can
# (build-rust.bat / cargo-zigbuild): it links against webkit2gtk, GTK3 and friends at build
# time, and its deb/rpm bundling steps must run in a real Linux userland. So the
# Linux installers are built in a container instead - the same approach CI takes.
#
# The base image is the compatibility floor: the binaries it produces need the build
# container's glibc or newer, so BASE_IMAGE is pinned to the OLDEST distro that still has
# WebKitGTK 4.1 (Tauri 2's hard requirement - Ubuntu 20.04 only ships the 4.0 API and can
# never work):
#
#   ubuntu:22.04  deb: glibc 2.35 -> runs on Ubuntu 22.04/24.04/25.x/26.04,
#                 Debian 12/13, Mint 21+, Pop!_OS 22.04+
#   fedora:38     rpm: glibc 2.37 -> runs on Fedora 38+, openSUSE Leap 15.6+/Tumbleweed
#
# The build context is this directory (the image needs nothing else from the repository),
# which keeps node_modules and target/ out of the context transfer:
#
#   docker build --build-arg BASE_IMAGE=ubuntu:22.04 -t ggs-linux-builder -f scripts/docker/Dockerfile.studio-linux scripts/docker

ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

# Tauri 2's Linux build dependencies (the same set CI installs), plus the toolchain basics
# and the rpm bundler's tool (rpmbuild, in rpm-build). xz unpacks the Node tarball.
RUN if command -v apt-get >/dev/null 2>&1; then \
        DEBIAN_FRONTEND=noninteractive apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
            build-essential ca-certificates curl file git pkg-config xz-utils \
            libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
            librsvg2-dev libxdo-dev libssl-dev \
        && rm -rf /var/lib/apt/lists/*; \
    else \
        dnf install -y --setopt=install_weak_deps=False \
            gcc gcc-c++ ca-certificates curl file git pkgconfig xz \
            webkit2gtk4.1-devel gtk3-devel libappindicator-gtk3-devel \
            librsvg2-devel libxdo-devel openssl-devel rpm-build findutils diffutils \
        && dnf clean all; \
    fi

# Node 20 from the official tarball (CI's setup-node version), no external distro repo needed.
RUN curl -fsSL https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-x64.tar.xz \
        | tar -xJ -C /usr/local --strip-components=1

# Rust stable, minimal profile. RUSTUP_HOME/CARGO_HOME are split so a build can redirect
# CARGO_HOME to a cache volume (scripts/studio-linux-build.sh) while the toolchains stay here.
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rwX /opt/rustup /opt/cargo
